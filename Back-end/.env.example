PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartmeet
JWT_SECRET=mysecretkey123
JWT_EXPIRE=30d

# AI - Meeting Analysis (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Speech-to-Text Service (FastAPI Faster-Whisper)
STT_SERVICE_URL=http://localhost:8001/transcribe

# Optional: Vector Store Provider (mongo | pinecone | chroma)
VECTOR_STORE_PROVIDER=mongo

# Optional: ffmpeg path (defaults to "ffmpeg" on PATH)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
